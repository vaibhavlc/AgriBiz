# Backend Environment Configuration Example (Render & MongoDB Atlas)

# Environment (production or development)
NODE_ENV=production

# Server Port (Render automatically supplies process.env.PORT, default 5000 for local dev)
PORT=5000

# MongoDB Atlas SRV Connection String
# Replace <username>, <password>, and cluster domain with your MongoDB Atlas details
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/agribiz?retryWrites=true&w=majority

# JWT Security Secrets (Use long random strings in production)
JWT_SECRET=your_super_secret_access_token_key_change_in_production_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_change_in_production_32_chars

# Frontend Client URL(s) on Vercel for CORS & Security Cookie validation
# Separate multiple URLs with commas if needed
CLIENT_URL=https://your-frontend-app.vercel.app
CORS_ORIGIN=https://your-frontend-app.vercel.app

# Admin Management Secret Key
ADMIN_SECRET=agribiz_admin_secret_key_change_in_production
