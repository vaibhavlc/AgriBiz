# Backend Environment Configuration Example
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/agribiz?retryWrites=true&w=majority

# JWT Security Secrets (Use long random strings in production)
JWT_ACCESS_SECRET=your_super_secret_access_token_key_change_in_production_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_change_in_production_32_chars

# Frontend Client URL (For CORS & Security cookies)
CLIENT_URL=https://agribiz.vercel.app
CORS_ORIGIN=https://agribiz.vercel.app

# Admin Management Secret
ADMIN_SECRET=agribiz_admin_secret_key_change_me
